{
  "name": "tower-defense-heroes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "balance": "vitest run --config vitest.balance.config.ts",
    "e2e:webkit": "playwright test --browser=webkit",
    "build:server": "node tools/build-server.mjs",
    "server": "npm run build && npm run build:server && node server-dist/main.js"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
